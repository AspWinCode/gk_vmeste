# Сервер
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# База данных
DATABASE_URL=postgresql://vmeste:vmeste@localhost:5432/vmeste_ai

# Redis (очереди BullMQ)
REDIS_URL=redis://localhost:6379

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Загрузка файлов
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# STT-провайдер для транскрибации (заглушка на старте — см. src/services/speechToText.ts)
STT_PROVIDER=stub
STT_API_KEY=

# Email (для рассылки протоколов встреч)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ВМЕСТЕ AI <noreply@vmeste.local>"
