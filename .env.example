# Используется docker-compose.prod.yml. Скопировать в .env в корне репозитория на VPS
# и заполнить реальными значениями перед первым запуском.

# Пароль для контейнера Postgres (DATABASE_URL собирается автоматически в compose-файле)
POSTGRES_PASSWORD=change-me

# На каком хост-порту слушает фронтенд/nginx. По умолчанию 8092 — порт 80/443 занят
# системным nginx с другими проектами на сервере, трогать его нельзя.
HTTP_PORT=8092

PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# Можно оставить пустым на старте — приложение запустится, просто AI-функции
# (транскрибатор, финансовый риск-анализ, разбор земли/льгот/почты) будут отдавать
# ошибку при вызове, пока ключ не появится.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Если используете прокси вместо api.anthropic.com напрямую (например, AI Tunnel) —
# укажите его базовый URL здесь. Пусто = обычный официальный эндпоинт.
ANTHROPIC_BASE_URL=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

STT_PROVIDER=stub
STT_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ВМЕСТЕ AI <noreply@vmeste.local>"
