# Используется docker-compose.prod.yml. Скопировать в .env в корне репозитория на VPS
# и заполнить реальными значениями перед первым запуском.

# Пароль для контейнера Postgres (DATABASE_URL собирается автоматически в compose-файле)
POSTGRES_PASSWORD=change-me

PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

STT_PROVIDER=stub
STT_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ВМЕСТЕ AI <noreply@vmeste.local>"
